generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int       @id @default(autoincrement())
  firstName        String
  lastName         String
  email            String    @unique
  password         String
  createdAt        DateTime  @default(now())
  phone            String?
  house            String?
  street           String?
  landmark         String?
  city             String?
  zip              String?
  resetToken       String?
  resetTokenExpiry DateTime?
  role             String    @default("USER")
  shirtSize        String?
  shoeSize         String?
  waistSize        String?
  orders           Order[]
}

model Order {
  id              Int      @id @default(autoincrement())
  userId          Int?
  totalAmount     Float
  paymentId       String?
  shippingDetails String
  cartItems       String
  status          String   @default("Processing")
  trackingNumber  String?
  trackingUrl     String?
  createdAt       DateTime @default(now())
  user            User?    @relation(fields: [userId], references: [id])
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  price       Float
  category    String
  size        String?
  condition   String?
  material    String?
  era         String?
  color       String?
  brand       String?
  thriftStory String?
  images      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isFreshDrop Boolean  @default(false)
  isSoldOut   Boolean  @default(false)
}

model Category {
  id        String   @id
  name      String   @unique
  slug      String   @unique
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
